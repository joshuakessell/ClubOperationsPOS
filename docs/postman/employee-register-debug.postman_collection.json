          }
        },
        {
          "name": "Waitlist OFFERED (GET /v1/waitlist?status=OFFERED) [Auth]",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staffToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/waitlist?status=OFFERED",
              "host": ["{{baseUrl}}"],
