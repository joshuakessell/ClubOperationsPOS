{
  "info": {
    "_postman_id": "8fe7f50c-c5b0-4d76-8b57-b8ac2b39c4d4",
    "name": "Employee Register - Debug Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Focused requests for Employee Register troubleshooting: heartbeat, inventory, waitlist, realtime auth, and lane assignment."
  },
  "item": [
    {
      "name": "Register",
      "item": [
        {
          "name": "Register Status (GET /v1/registers/status)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/registers/status?deviceId={{deviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "registers", "status"],
              "query": [
                {
                  "key": "deviceId",
                  "value": "{{deviceId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Register Heartbeat (POST /v1/registers/heartbeat)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/registers/heartbeat",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "registers", "heartbeat"]
            }
          }
        },
        {
          "name": "Register Activity (POST /v1/registers/activity)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/registers/activity",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "registers", "activity"]
            }
          }
        }
      ]
    },
