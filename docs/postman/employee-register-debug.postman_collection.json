    {
      "name": "Realtime",
      "item": [
        {
          "name": "Realtime Auth (POST /v1/realtime/auth) [Kiosk token or Staff auth]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-kiosk-token",
                "value": "{{kioskToken}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{staffToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channels\": [\n    \"/club-ops/global\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/realtime/auth",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "realtime", "auth"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Convenience: capture endpoint for quick inspection.",
                  "try {",
                  "  const json = pm.response.json();",
                  "  if (json && json.realtimeEndpoint) pm.environment.set('realtimeEndpoint', json.realtimeEndpoint);",
                  "} catch (e) {}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Check-in",
      "item": [
        {
          "name": "Lane Session Snapshot (GET /v1/checkin/lane/:laneId/session-snapshot)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-kiosk-token",
                "value": "{{kioskToken}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{staffToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/checkin/lane/{{laneId}}/session-snapshot",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "checkin", "lane", "{{laneId}}", "session-snapshot"]
            }
          }
        },
        {
          "name": "Assign Resource (POST /v1/checkin/lane/:laneId/assign) [Auth]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{staffToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"room\",\n  \"resourceId\": \"{{roomId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/checkin/lane/{{laneId}}/assign",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "checkin", "lane", "{{laneId}}", "assign"]
            }
          }
        }
      ]
    }
  ]
}

