          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staffToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/waitlist?status=ACTIVE",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "waitlist"],
