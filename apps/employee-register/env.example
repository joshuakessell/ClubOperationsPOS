# Employee Register (Vite) environment variables
#
# Production (AWS):
# - Set VITE_API_BASE_URL to your API origin so realtime + REST calls go to the API service
#   (no trailing slash).

# API origin (NO trailing slash, and NOT ".../api")
VITE_API_BASE_URL=https://your-api.example.com

# Shared kiosk token used for kiosk-facing API auth (matches API's KIOSK_TOKEN)
VITE_KIOSK_TOKEN=your-shared-kiosk-token

# Realtime provider (legacy = API, appsync-events = AWS AppSync Events)
VITE_REALTIME_PROVIDER=appsync-events

# Realtime channel namespace (must match API namespace)
VITE_REALTIME_CHANNEL_NAMESPACE=club-ops

# Optional: disable realtime usage and rely on polling fallback
VITE_DISABLE_REALTIME=false
