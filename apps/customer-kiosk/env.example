# Customer Kiosk (Vite) environment variables
#
# Production (AWS):
# - Set VITE_API_BASE_URL to your API origin so WebSockets (legacy) and REST calls
#   go to the API service (no trailing slash).
#
# Local dev:
# - You can omit VITE_API_BASE_URL to keep same-origin `/ws` so the Vite dev proxy can forward to the API.

# API origin (NO trailing slash, and NOT ".../api")
VITE_API_BASE_URL=https://your-api.example.com

# Shared kiosk token used for kiosk-facing API + WS auth (matches API's KIOSK_TOKEN)
VITE_KIOSK_TOKEN=your-shared-kiosk-token

# Realtime provider (legacy = API /ws, appsync-events = AWS AppSync Events)
VITE_REALTIME_PROVIDER=appsync-events

# Realtime channel namespace (must match API namespace)
VITE_REALTIME_CHANNEL_NAMESPACE=club-ops

# Optional: disable WebSocket usage and rely on polling fallback
# (useful when the API host blocks WS upgrades)
VITE_DISABLE_WS=false
