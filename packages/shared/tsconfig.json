{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "outDir": "./dist-new",
    "rootDir": "."
  },
  "include": [
    "index.ts",
    "src/**/*",
    "realtime/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-new",
    "tests"
  ]
}