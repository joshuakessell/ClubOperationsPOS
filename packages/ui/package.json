{
  "name": "@club-ops/ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tailadmin": {
      "types": "./src/tailadmin/index.ts",
      "import": "./src/tailadmin/index.ts"
    },
    "./tailadmin/theme.css": "./src/tailadmin/theme.css"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@club-ops/shared": "workspace:*",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0"
  }
}